# Copy to .env.local for `vercel dev` and fill in. Never commit the filled in copy.
# In production these are set in the Vercel project, under Settings, Environment
# Variables. `vercel env pull .env.local` fetches them from there.

# --- Supabase (required for the sync panel and Telegram lightning alerts) ---
# Leave both blank and the sync panel reports that syncing is not switched on.
# The weather itself is untouched. The service role key bypasses row level
# security, so it belongs in Vercel and on the bot's VPS, nowhere else.
# Run migrations/0001 and 0002 in the Supabase SQL editor first.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=

# --- data.gov.sg (optional, recommended) ---
# Everything NEA reports about Singapore: forecasts, stations, radar, UV, WBGT,
# lightning, PSI and PM2.5. Works without a key at a lower rate limit; the key
# lifts it, which the collect cron's backfill leans on.
DATA_GOV_KEY=

# --- Vercel Cron ---
# Any long random string, e.g. from `openssl rand -hex 32`. Vercel Cron sends it
# to /api/cron/collect, which refuses calls without it. Without it nothing is
# collected and no lightning alerts are sent.
CRON_SECRET=

# --- Upstash Redis: lightning alerts and the map's three hour timeline ---
# Connecting it from the Vercel Marketplace sets these two; the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pair from upstash.com works
# too. Without it, alerts are off and the map's timeline carries rainfall and
# lightning only, fetched live. Keys are prefixed "uwuweather:", so sg-psi's
# store can be shared.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob: the crons' copies ---
# Create a Blob store in the Vercel project (Storage, Create, Blob) and connect
# it; that sets this. It holds NEA's radar frames, NEA's bundle and every
# recently viewed place's weather, so visitors read copies instead of each asking
# upstream, and the map's three hours of NEA radar stay complete. Without it the
# sg and places crons do nothing and every route asks upstream itself.
BLOB_READ_WRITE_TOKEN=

# --- Keyed weather services: fallbacks when Open-Meteo doesn't answer ---
# All optional; any left blank is skipped. Free plans: lib/cache.js holds each
# to a budget a little under its limit (QUOTAS), and answers are cached with the
# place, so a failing Open-Meteo costs one call per place per ten minutes.
# WeatherAPI.com, tried first, also covers air quality.
WEATHER_API_KEY=
# OpenWeather, tried second: the free 2.5 endpoints, and the radar tiles the map
# falls back to when RainViewer doesn't answer.
OPEN_WEATHER_KEY=
# Xweather, tried last. Both halves of the app's credentials.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# --- China (optional) ---
# Seniverse, laid over Open-Meteo in China like the national services elsewhere.
# Both halves of the key from the Seniverse console; requests are signed with
# them, so the private key isn't sent. Without them, China is Open-Meteo's.
SENIVERSE_PUBLIC_KEY=
SENIVERSE_PRIVATE_KEY=
# The World Air Quality Index Project, for China's air quality from its
# monitoring stations. A free token from https://aqicn.org/data-platform/token.
# Without it, China's air quality is Open-Meteo's model.
WAQI_TOKEN=

# --- NILU (optional): measured air quality in Norway ---
# api.nilu.no now asks for a login. "user:password". Without it, Norway's air
# quality is MET Norway's forecast for the hour instead.
NILU_AUTH=

# --- Lightning alerts by web push ---
# From `npx web-push generate-vapid-keys`. Generate once and keep them: new keys
# invalidate every existing subscription. Use a pair of this site's own, not
# sg-psi's, since a subscription is tied to the key it was made with.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you if something goes wrong. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com

# --- Optional, sensible defaults are used when unset ---
# The bot the sync panel deep links to. Defaults to uwuweatherapp_bot.
TELEGRAM_BOT_USERNAME=uwuweatherapp_bot
