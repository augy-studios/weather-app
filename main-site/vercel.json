{
  "regions": ["sin1"],
  "functions": {
    "api/cron/collect.js": { "maxDuration": 60 },
    "api/timeline.js": { "maxDuration": 30 },
    "api/radar.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/collect", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/lib/:path*", "destination": "/404.html" },
    { "source": "/migrations/:path*", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "geolocation=*" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
