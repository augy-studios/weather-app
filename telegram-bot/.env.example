# Copy to .env and fill in. Never commit the filled in copy.

# --- Telegram (required) ---
# From https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAaaBBbbCCccDDddEEeeFFffGGgg

# --- Supabase (required for /link, /code and favourite syncing) ---
# Leave both blank to run the bot standalone. Weather, favourites and the
# daily digest still work; only syncing with the web app is switched off.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=

# --- Links shown on buttons (required) ---
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# --- Optional, sensible defaults are used when unset ---
# Public origin of the web app, used for deep links and the magic link button.
WEB_APP_URL=https://weatherapp.today
# Where the SQLite file lives, relative paths resolve against this directory.
DB_PATH=data/bot.db
# Seconds between checks for messages the web app has left for the bot to send.
NOTICE_POLL_SECONDS=3
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
